            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"affId\": \"<string>\",\n  \"token\": \"<string>\",\n  \"rxNo\": \"<string>\",\n  \"appID\": \"<string>\",\n  \"act\": \"<string>\",\n  \"lat\": \"<double>\",\n  \"lng\": \"<double>\",\n  \"trackingId\": \"<string>\",\n  \"appVer\": \"<string>\",\n  \"devInf\": \"<string>\"\n}",
