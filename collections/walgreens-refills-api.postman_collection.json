        {
          "id": "49da3cea-d60e-48c9-a563-1f8f4a59c78e",
          "name": "Submit Prescription Refill",
          "request": {
            "name": "Submit Prescription Refill",
            "description": {
              "content": "Submits a prescription refill request using the prescription number obtained via barcode scan. Requires the token from the Obtain Refill URL step and loads a WebView-based checkout for the patient to complete the refill.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "rx",
                "refill"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
