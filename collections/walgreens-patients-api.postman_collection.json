  "info": {
    "_postman_id": "b19edd73-90ff-48c6-91ed-d5aa1cf59ba9",
    "name": "Walgreens Prescription Refill Appointments Patients API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Enables medication management application developers to process prescription refills and transfers at any Walgreens pharmacy location. Supports barcode scanning for refill initiation and image-based prescription transfers from other pharmacies. Processes prescriptions from 8,200+ Walgreens pharmacies with mobile-optimized WebView checkout flows.",
      "type": "text/plain"
    }
