          "name": "Get Vaccine Timeslots",
          "request": {
            "name": "Get Vaccine Timeslots",
            "description": {
              "content": "Retrieves available appointment timeslots for specified vaccines at Walgreens locations near a given zip code and coordinates. Returns locations with their available dates and time slots, vaccine product information, and distance from the specified position.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "vaccine",
                "scheduling",
                "timeslots",
                "v1"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
